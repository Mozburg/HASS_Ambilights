[Unit]
Description=HASS Ambilights - mirror the screen onto Home Assistant lights
After=graphical-session.target network-online.target
Wants=network-online.target
# A wrong port or address exits non-zero; without a limit that becomes a restart
# loop every RestartSec.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
# Run as the desktop user who owns the session, or the capture thread has no display.
User=%i
WorkingDirectory=/opt/hass-ambilights
# Credentials, mode 0600, so the token is not in a world-readable unit file:
#   HA_URL=http://192.168.1.10:8123
#   HA_TOKEN=...
EnvironmentFile=-/etc/hass-ambilights.env
# The capture thread needs the session's X display on X11 (not Wayland, not Windows).
Environment=DISPLAY=:0
ExecStart=/opt/hass-ambilights/.venv/bin/python hass_ambilights.py --server --no-browser
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
